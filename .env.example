APP_ENV=development
DATABASE_URL=sqlite:///./esbot.db
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173
BUSINESS_TIMEZONE=Asia/Tehran

# Bale bot integration (leave blank to disable polling)
BALE_BOT_TOKEN=
BALE_ADMIN_CHAT_ID=
BALE_POLLING_ENABLED=true
BALE_POLL_TIMEOUT_SECONDS=20
